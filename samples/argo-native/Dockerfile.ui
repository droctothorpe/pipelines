FROM nginxinc/nginx-unprivileged:1.29-alpine
# Single-user mode reads the pod's service-account token through njs.
USER root
RUN sed -i '1i load_module modules/ngx_http_js_module.so;' /etc/nginx/nginx.conf
USER 101
ENV KFP_UI_AUTH_MODE=token KFP_UI_NAMESPACE=
COPY frontend/build/ /usr/share/nginx/html/
COPY frontend/build/argo.html /usr/share/nginx/html/index.html
COPY samples/argo-native/ui-proxy.js /etc/nginx/ui-proxy.js
COPY samples/argo-native/nginx.conf.template /etc/nginx/templates/default.conf.template
